#version 460 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in vec2 aTexCoord;

out vec3 fragPosView;
out vec3 normalView;
out vec2 texCoord;

uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;
uniform mat4 normalMatrixView;

void main()
{
    fragPosView = vec3(view * model * vec4(aPos, 1.0));
    normalView = vec3(normalMatrixView * vec4(aNormal, 0.0));
    texCoord = aTexCoord;

    gl_Position = projection * vec4(fragPosView, 1.0);
}