#version 460 core

struct Material
{
    sampler2D diffuse;
    sampler2D specular;
    sampler2D emission;
    float shininess;
};

struct Light
{
    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
};

in vec3 fragPosView;
in vec3 normal;
in vec2 texCoord;
in vec3 lightPosView;

out vec4 fragColor;

uniform Material material;
uniform Light light;

void main()
{
    vec3 ambient = texture(material.diffuse, texCoord).rgb * light.ambient;

    vec3 unitNormal = normalize(normal);
    vec3 lightDir = normalize(fragPosView - lightPosView);
    float diffuseStrength = max(dot(-lightDir, unitNormal), 0.0);
    vec3 diffuse = diffuseStrength * texture(material.diffuse, texCoord).rgb * light.diffuse;

    vec3 viewDir = normalize(fragPosView);
    vec3 reflectDir = reflect(lightDir, unitNormal);
    float specularStrength = 0.5 * pow(max(dot(-viewDir, reflectDir), 0.0), material.shininess);
    vec3 specular = specularStrength * texture(material.specular, texCoord).rgb * light.specular;

    float emissionStrength = 1.0;
    vec3 emission = emissionStrength * texture(material.emission, texCoord).rgb;

    vec3 result = ambient + diffuse + specular + emission;
    fragColor = vec4(result, 1.0);
}