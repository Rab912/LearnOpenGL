#version 460 core

struct Material
{
    sampler2D diffuse;
    sampler2D specular;
    sampler2D emission;
    float shininess;
};

// A basic test light
struct Light
{
    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
};

struct DirectionalLight
{
    vec3 direction;

    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
};

struct PointLight
{
    vec3 position;

    float constant;
    float linear;
    float quadratic;

    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
};

struct SpotLight
{
    vec3 position;
    vec3 direction;

    float cutoff;
    float outerCutoff;

    float constant;
    float linear;
    float quadratic;

    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
};

in vec3 fragPosView;
in vec3 normalView;
in vec2 texCoord;

out vec4 fragColor;

uniform mat4 view;
uniform Material material;

uniform DirectionalLight dirLight;
uniform PointLight pointLight;
uniform SpotLight spotLight;

// View-space lighting functions (requires view-space normals and fragment positions)

vec3 CalcDirectionalLighting(DirectionalLight light, vec3 normal, vec3 viewDir)
{
    vec3 lightDir = normalize(mat3(view) * light.direction);
    vec3 reflectDir = reflect(lightDir, normal);

    vec3 ambient = texture(material.diffuse, texCoord).rgb * light.ambient;
    
    float diffuseStrength = max(dot(-lightDir, normal), 0.0);
    vec3 diffuse = diffuseStrength * texture(material.diffuse, texCoord).rgb * light.diffuse;
    
    float specularStrength = 0.5 * pow(max(dot(-viewDir, reflectDir), 0.0), material.shininess);
    vec3 specular = specularStrength * texture(material.specular, texCoord).rgb * light.specular;
    
    return (ambient + diffuse + specular);
}

vec3 CalcPointLighting(PointLight light, vec3 normal, vec3 fragPos, vec3 viewDir)
{
    vec3 lightFragDelta = fragPos - vec3(view * vec4(light.position, 1.0));
    vec3 lightDir = normalize(lightFragDelta);
    vec3 reflectDir = reflect(lightDir, normal);

    float distance = length(lightFragDelta);
    float attenuation = 1.0 / (light.constant +
                               light.linear * distance +
                               light.quadratic * distance * distance);

    vec3 ambient = texture(material.diffuse, texCoord).rgb * light.ambient * attenuation;
    
    float diffuseStrength = max(dot(-lightDir, normal), 0.0);
    vec3 diffuse = diffuseStrength * texture(material.diffuse, texCoord).rgb * light.diffuse * attenuation;
    
    float specularStrength = 0.5 * pow(max(dot(-viewDir, reflectDir), 0.0), material.shininess);
    vec3 specular = specularStrength * texture(material.specular, texCoord).rgb * light.specular * attenuation;

    return (ambient + diffuse + specular);
}

vec3 CalcSpotLighting(SpotLight light, vec3 normal, vec3 fragPos, vec3 viewDir)
{   
    vec3 lightFragDelta = fragPos - vec3(view * vec4(light.position, 1.0));
    vec3 lightDir = normalize(lightFragDelta);

    float distance = length(lightFragDelta);
    float attenuation = 1.0 / (light.constant +
                               light.linear * distance +
                               light.quadratic * distance * distance);

    vec3 ambient = texture(material.diffuse, texCoord).rgb * light.ambient * attenuation;

    float cosCutoff = cos(light.cutoff);
    float cosOuterCutoff = cos(light.outerCutoff);
    float cosAngle = dot(lightDir, normalize(mat3(view) * light.direction));

    float eps = cosCutoff - cosOuterCutoff;
    float intensity = clamp((cosAngle - cosOuterCutoff) / eps, 0.0, 1.0);

    vec3 reflectDir = reflect(lightDir, normal);
    
    float diffuseStrength = max(dot(-lightDir, normal), 0.0);
    vec3 diffuse = diffuseStrength * texture(material.diffuse, texCoord).rgb * light.diffuse * attenuation * intensity;
    
    float specularStrength = 0.5 * pow(max(dot(-viewDir, reflectDir), 0.0), material.shininess);
    vec3 specular = specularStrength * texture(material.specular, texCoord).rgb * light.specular * attenuation * intensity;

    return (ambient + diffuse + specular);
}

void main()
{
    vec3 unitNormalView = normalize(normalView);
    vec3 viewDir = normalize(fragPosView);

    vec3 color = vec3(0.0);

    color += CalcDirectionalLighting(dirLight, unitNormalView, viewDir);
    color += CalcPointLighting(pointLight, unitNormalView, fragPosView, viewDir);
    color += CalcSpotLighting(spotLight, unitNormalView, fragPosView, viewDir);

    float emissionStrength = 0.0;
    vec3 emission = emissionStrength * texture(material.emission, texCoord).rgb;

    color += emission;

    //vec3 unitNormalView = normalize(normalView);
    //vec3 lightFragDelta = fragPosView - vec3(view * vec4(pointLight.position, 1.0));
    //vec3 lightDir = normalize(lightFragDelta); //normalize(dirLight.direction);
