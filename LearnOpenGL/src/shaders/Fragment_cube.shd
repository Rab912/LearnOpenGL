    //float distance = length(lightFragDelta);
    //float attenuation = 1.0 / (pointLight.constant +
    //                           pointLight.linear * distance +
    //                           pointLight.quadratic * distance * distance);
    //
    //vec3 ambientLight = pointLight.ambient * attenuation; // dirLight.ambient;
    //vec3 diffuseLight = pointLight.diffuse * attenuation; // dirLight.diffuse;
    //vec3 specularLight = pointLight.specular * attenuation; // dirLight.specular;
    //
    //vec3 ambient = texture(material.diffuse, texCoord).rgb * ambientLight;
    //
    //float diffuseStrength = max(dot(-lightDir, unitNormalView), 0.0);
    //vec3 diffuse = diffuseStrength * texture(material.diffuse, texCoord).rgb * diffuseLight;
    //
    //float specularStrength = 0.5 * pow(max(dot(-viewDir, reflectDir), 0.0), material.shininess);
    //vec3 specular = specularStrength * texture(material.specular, texCoord).rgb * specularLight;
    //
    //float emissionStrength = 0.3;
    //vec3 emission = emissionStrength * texture(material.emission, texCoord).rgb;
    //
    //vec3 result = ambient + diffuse + specular + emission;
    //fragColor = vec4(result, 1.0);

    fragColor = vec4(color, 1.0);
}